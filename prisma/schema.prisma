generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String           @id
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false)
  role          String           @default("user")
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  enrollments   Enrollment[]
  progress      LessonProgress[]
  certificates  Certificate[]
  reviews       Review[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===== โดเมนแพลตฟอร์มขายคอร์ส =====
// จำนวนเงินทุกฟิลด์เก็บเป็น Int หน่วย "สตางค์" (1 บาท = 100) เพื่อเลี่ยงปัญหา floating point
// ฟิลด์สถานะเก็บเป็น String ค่าที่อนุญาตกำหนดไว้ใน src/lib/shared/status.ts

model Category {
  id      Int      @id @default(autoincrement())
  name    String
  slug    String   @unique
  courses Course[]

  @@map("categories")
}

model Course {
  id           Int           @id @default(autoincrement())
  slug         String        @unique
  title        String
  summary      String
  description  String
  priceSatang  Int
  /// BEGINNER | INTERMEDIATE | ADVANCED
  level        String
  imageName    String
  isPublished  Boolean       @default(true)
  categoryId   Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lessons      Lesson[]
  orderItems   OrderItem[]
  enrollments  Enrollment[]
  reviews      Review[]
  certificates Certificate[]

  @@index([categoryId])
  @@map("courses")
}

model Lesson {
  id              Int              @id @default(autoincrement())
  courseId        Int
  title           String
  youtubeId       String
  durationMinutes Int
  position        Int
  isPreview       Boolean          @default(false)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]

  @@unique([courseId, position])
  @@map("lessons")
}

model Coupon {
  id                Int      @id @default(autoincrement())
  code              String   @unique
  /// PERCENT | FIXED
  type              String
  /// PERCENT: 1-100, FIXED: สตางค์
  value             Int
  maxDiscountSatang Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  orders            Order[]

  @@map("coupons")
}

model Order {
  id             Int         @id @default(autoincrement())
  userId         String
  /// PENDING | PAID | FAILED
  status         String
  subtotalSatang Int
  discountSatang Int
  totalSatang    Int
  couponId       Int?
  paymentRef     String?
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon         Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id             Int         @id @default(autoincrement())
  orderId        Int
  courseId       Int
  priceSatang    Int
  discountSatang Int
  paidSatang     Int
  /// PENDING | PAID | REFUNDED (item ของ order ที่ FAILED จะค้างเป็น PENDING)
  status         String
  refundedAt     DateTime?
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Restrict: คอร์สที่ขายไปแล้วลบไม่ได้ ให้ยกเลิกการเผยแพร่แทน
  course         Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment     Enrollment?

  @@index([orderId])
  @@index([courseId])
  @@map("order_items")
}

model Enrollment {
  id          Int        @id @default(autoincrement())
  userId      String
  courseId    Int
  /// null = ลงทะเบียนคอร์สฟรี (ไม่มี order)
  orderItemId Int?       @unique
  /// ACTIVE | REVOKED
  status      String
  enrolledAt  DateTime
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  userId      String
  lessonId    Int
  completedAt DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("lesson_progress")
}

model Certificate {
  id       Int      @id @default(autoincrement())
  code     String   @unique
  userId   String
  courseId Int
  issuedAt DateTime
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("certificates")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    String
  courseId  Int
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("reviews")
}
